<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6E8CFB"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="274dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="268dp"
        android:layout_marginBottom="312dp"
        android:fontFamily="@font/m6x11plus"
        android:text="Ping Pong"
        android:textColor="#FFFFFFFF"
        android:textSize="60sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/nom"
        android:layout_width="230dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="256dp"
        android:height="50dp"
        android:background="#636CCB"
        android:elegantTextHeight="false"
        android:ems="10"
        android:hint="ingrese Nom"
        android:inputType="text"
        android:text="asd"
        android:textColor="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/ip"
        android:layout_width="228dp"
        android:layout_height="61dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="261dp"
        android:height="50dp"
        android:background="#636CCB"
        android:ems="10"
        android:inputType="text"
        android:text="10.0.2.2"
        android:textColor="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nom" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="157dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/m6x11plus"
        android:text="Nom: "
        android:textColor="#FFFFFFFF"
        android:textSize="35sp"
        app:layout_constraintEnd_toStartOf="@+id/nom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/msgStatusName"
        android:layout_width="179dp"
        android:layout_height="29dp"
        android:fontFamily="@font/m6x11plus"
        android:text="Nom: "
        android:textColor="#FFFFFFFF"
        android:textSize="25sp"
        app:layout_constraintBottom_toTopOf="@+id/ip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nom"
        app:layout_constraintVertical_bias="1.0"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="163dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="36dp"
        android:fontFamily="@font/m6x11plus"
        android:text="IP: "
        android:textColor="#FFFFFFFF"
        android:textSize="35sp"
        app:layout_constraintEnd_toStartOf="@+id/ip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="167dp"
        android:layout_height="49dp"
        android:layout_marginStart="264dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="300dp"
        android:background="#50589C"
        android:fontFamily="@font/m6x11plus"
        android:text="Connect"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ip" />

</androidx.constraintlayout.widget.ConstraintLayout>